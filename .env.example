# Settings the Leader Portal needs. Set these in Vercel (Settings > Environment
# Variables) for Production and Preview. Never commit real secret values.
#
# Copy keys with the copy button, not by selecting the text. Supabase and Vercel
# show keys masked as dots (•••). If the value you paste contains dots, it is
# the masked version and the portal will not be able to sign anyone in.
# Changing a value only takes effect after the next deployment.

# Public (type: Config). Safe to be visible in the browser.
VITE_SUPABASE_URL=https://cdrtryvznisgvgiuflia.supabase.co
VITE_SUPABASE_ANON_KEY=paste-the-anon-public-key-here

# Server only, used by api/admin.js
SUPABASE_URL=https://cdrtryvznisgvgiuflia.supabase.co
SITE_URL=https://www.hpcchurch.church
# Type: Secret. From Supabase > Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here-in-vercel-only
